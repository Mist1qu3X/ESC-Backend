{
  "collectionName": "components_document_attachments",
  "info": {
    "displayName": "Attachment",
    "description": "A single downloadable file within a document",
    "icon": "file"
  },
  "options": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "version": {
      "type": "string",
      "default": "v1.0"
    },
    "date": {
      "type": "date"
    },
    "fileSize": {
      "type": "string",
      "default": "1.0 MB"
    },
    "downloadCount": {
      "type": "integer",
      "default": 0
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    }
  }
}
