{
  "kind": "collectionType",
  "collectionName": "core_values",
  "info": {
    "singularName": "core-value",
    "pluralName": "core-values",
    "displayName": "Core Value",
    "description": "CORE VALUES cards on the About Us page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "text": {
      "type": "text",
      "required": true
    },
    "iconKey": {
      "type": "enumeration",
      "enum": ["target", "shield", "globe"],
      "default": "target",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
