{
  "kind": "collectionType",
  "collectionName": "event_results",
  "info": {
    "singularName": "event-result",
    "pluralName": "event-results",
    "displayName": "Event Result",
    "description": "Results grouped per event: pick the event, then add leader rows"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event"
    },
    "discipline": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["ALL", "MEN", "WOMEN", "JUNIOR MEN", "JUNIOR WOMEN", "MIXED"],
      "default": "ALL",
      "required": true
    },
    "stage": {
      "type": "enumeration",
      "enum": ["Final", "Qualification", "Ranking Match", "Medal Match"]
    },
    "leaders": {
      "type": "component",
      "repeatable": true,
      "component": "results.leader"
    }
  }
}
