{
  "kind": "collectionType",
  "collectionName": "live_streams",
  "info": {
    "singularName": "live-stream",
    "pluralName": "live-streams",
    "displayName": "Live Stream",
    "description": "Live streaming platforms and events"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "eventName": {
      "type": "string"
    },
    "eventSlug": {
      "type": "string"
    },
    "platform": {
      "type": "enumeration",
      "enum": ["youtube", "facebook"],
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
