{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": "Document categories (admin-managed: add/rename/delete)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "docs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::doc.doc",
      "mappedBy": "category"
    }
  }
}
