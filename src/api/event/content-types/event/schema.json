{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Competitions and events calendar"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["competition", "education", "meeting"],
      "required": true,
      "default": "competition"
    },
    "statusEvent": {
      "type": "enumeration",
      "enum": ["UPCOMING", "FINISHED"],
      "required": true,
      "default": "UPCOMING"
    },
    "resultsPending": {
      "type": "boolean",
      "default": false
    },
    "docsChecked": {
      "type": "boolean",
      "default": false
    },
    "hasResults": {
      "type": "boolean",
      "default": false
    },
    "hasResultBook": {
      "type": "boolean",
      "default": false
    },
    "showStreams": {
      "type": "boolean",
      "default": true
    },
    "category": {
      "type": "string",
      "default": "SENIOR"
    },
    "month": {
      "type": "string"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "athletes": {
      "type": "string",
      "default": "480+"
    },
    "nations": {
      "type": "string",
      "default": "38"
    },
    "disciplines": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "schedule": {
      "type": "component",
      "repeatable": true,
      "component": "event.schedule-row"
    },
    "documents": {
      "type": "component",
      "repeatable": true,
      "component": "document.attachment"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
