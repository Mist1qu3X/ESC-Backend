{
  "kind": "collectionType",
  "collectionName": "docs",
  "info": {
    "singularName": "doc",
    "pluralName": "docs",
    "displayName": "Document",
    "description": "Documents library"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "externalId": {
      "type": "string"
    },
    "eventSlug": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "theme": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Official Documents",
        "Assemblies",
        "Sustainability",
        "Courses",
        "PRESS RELEASES",
        "Records",
        "Ranking",
        "Competitions",
        "European Championships",
        "European Champions League",
        "European Youth League",
        "European Cup 25m",
        "European Cup 300m",
        "ESC Air Cup",
        "European Games",
        "European Youth Olympic Festival",
        "Olympic Games"
      ]
    },
    "version": {
      "type": "string",
      "default": "v1.0"
    },
    "description": {
      "type": "text"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "fileSize": {
      "type": "string",
      "default": "1.0 MB"
    },
    "downloadCount": {
      "type": "integer",
      "default": 0
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "attachments": {
      "type": "component",
      "repeatable": true,
      "component": "document.attachment"
    },
    "previousVersions": {
      "type": "component",
      "repeatable": true,
      "component": "document.attachment"
    }
  }
}
